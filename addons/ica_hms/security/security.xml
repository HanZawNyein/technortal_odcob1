<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_hms">
            <field name="name">Hotel Management System</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_hms">
            <field name="name">Levels</field>
            <field name="category_id" ref="ica_hms.module_category_hms"/>
        </record>

        <record id="group_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="ica_hms.res_groups_privilege_hms"/>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="ica_hms.res_groups_privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('ica_hms.group_employee'))]"/>
        </record>

        <record id="group_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="ica_hms.res_groups_privilege_hms"/>
            <field name="implied_ids" eval="[(4, ref('ica_hms.group_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>


    <data>
        <record id="hms_room_employee_rule" model="ir.rule">
            <field name="name">hms_room_employee_rule</field>
            <field name="model_id" ref="ica_hms.model_hms_room"/>
            <field name="domain_force">[('type', '=', 'normal')]</field>
            <field name="groups" eval="[(4, ref('ica_hms.group_employee'))]"/>
        </record>

        <record id="hms_room_manger_rule" model="ir.rule">
            <field name="name">hms_room_manger_rule</field>
            <field name="model_id" ref="ica_hms.model_hms_room"/>
            <field name="domain_force">[('type', 'in',['normal','vip'])]</field>
            <field name="groups" eval="[(4, ref('ica_hms.group_manager'))]"/>
        </record>

        <record id="hms_room_admin_rule" model="ir.rule">
            <field name="name">hms_room_admin_rule</field>
            <field name="model_id" ref="ica_hms.model_hms_room"/>
            <field name="domain_force">[(1, '=',1)]</field>
            <field name="groups" eval="[(4, ref('ica_hms.group_admin'))]"/>
        </record>
    </data>
</odoo>