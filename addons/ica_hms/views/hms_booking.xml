<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="hms_booking_view_tree" model="ir.ui.view">
        <field name="name">hms_booking_view_tree_view_tree</field>
        <field name="model">hms.booking</field>
        <field name="arch" type="xml">
            <list string="hms_booking_view_tree_tree">
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="room_id"/>
                <field name="hotel_id" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge" decoration-danger=" state == 'cancelled'"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'confirmed'" decoration-muted="state == 'draft'"
                       decoration-it="state == 'check_out'"/>
                <field name="check_in_datetime" optional="hide"/>
                <field name="check_out_datetime" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hms_booking_view_form" model="ir.ui.view">
        <field name="name">hms_booking_view_form</field>
        <field name="model">hms.booking</field>
        <field name="arch" type="xml">
            <form string="hms_booking_form">
                <header>
                    <button name="action_draft" string="Draft" type="object" invisible="state != 'confirmed'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn btn-primary"
                            invisible="state != 'draft'"/>
                    <!--                    invisible="state != 'draft'"-->
                    <button name="%(ica_hms.hms_payment_action)d" type="action" class="btn btn-success"
                            string="Create Payment"
                            invisible="state != 'confirmed'"/>
                    <!--                    <button name="action_paid" string="Paid" type="object" class="btn btn-success"-->
                    <!--                            invisible="state != 'confirmed'"/>-->
                    <button name="action_check_in" string="Check In" type="object" class="btn btn-info"
                            invisible="state != 'paid'"/>
                    <!--                     invisible="state != 'paid'"-->
                    <button name="action_check_out" string="Check Out" type="object" class="btn btn-warning"
                            invisible="state != 'check_in'"/>
                    <!--                     invisible="state != 'check_in'"-->
                    <button name="action_cancel" string="Cancel" type="object" class="btn btn-danger"
                            invisible="state not in ['draft','confirmed']"/>
                    <!--                     invisible="state not in ['draft','confirmed']"-->
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid,check_in,check_out"/>
                </header>
                <sheet>
                    <div class="oe_title pe-0 w-100 mw-100" name="title">
                        <h1 class="d-flex flex-row justify-content-between">
                            <field name="reference" class="text-truncate" placeholder="Sequence Number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Guest Information">
                            <field name="partner_id"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Hotel Information">
                            <field name="hotel_id"/>
                            <field name="room_id" domain="[('hotel_id','=',hotel_id)]"/>
                            <field name="currency_id"/>
                            <field name="amount" widget="monetary"/>
                        </group>
                        <group string="Time Information">
                            <field name="check_in_datetime"/>
                            <field name="check_out_datetime"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </group>
                        <group string="Employee Information">
                            <field name="employee_id"/>
                            <field name="job_id"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="hms_booking_view_search" model="ir.ui.view">
        <field name="name">hms_booking_view_search</field>
        <field name="model">hms.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="reference"/>
                <field name="state"/>
                <field name="hotel_id"/>
                <filter string="Confirmed" name="confirm" domain="[('state', '=','confirmed')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=','paid')]"/>
                <filter string="Check In" name="check_in" domain="[('state', '=','check_in')]"/>
                <filter string="Check Out" name="check_out" domain="[('state', '=','check_out')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=','draft')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=','cancelled')]"/>
                <group>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hms_booking_action" model="ir.actions.act_window">
        <field name="name">Booking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hms.booking</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_state': 0, 'search_default_draft': 1}</field>
    </record>
</odoo>