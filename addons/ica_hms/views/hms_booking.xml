<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hms_booking_view_form" model="ir.ui.view">
        <field name="name">hms_booking_view_form</field>
        <field name="model">hms.booking</field>
        <field name="arch" type="xml">
            <form string="hms_booking_form">
                <header>
                    <button name="action_draft" string="Draft" type="object"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn btn-primary"/>
                    <!--                    invisible="state != 'draft'"-->
                    <button name="action_paid" string="Paid" type="object" class="btn btn-success"/>
                    <!--                    invisible="state != 'confirmed'"-->
                    <button name="action_check_in" string="Check In" type="object" class="btn btn-info"/>
                    <!--                     invisible="state != 'paid'"-->
                    <button name="action_check_out" string="Check Out" type="object" class="btn btn-warning"/>
                    <!--                     invisible="state != 'check_in'"-->
                    <button name="action_cancel" string="Cancel" type="object" class="btn btn-danger"/>
                    <!--                     invisible="state not in ['draft','confirmed']"-->
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid,check_in,check_out"/>
                </header>
                <sheet>
                    <div class="oe_title pe-0 w-100 mw-100" name="title">
                        <h1 class="d-flex flex-row justify-content-between">
                            <field name="reference" class="text-truncate" placeholder="Sequence NUmber"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Guest Information">
                            <field name="partner_id"/>
                        </group>
                        <group string="Hotel Information">
                            <field name="room_id"/>
                            <field name="hotel_id"/>
                            <field name="currency_id"/>
                            <field name="amount"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="hms_booking_action" model="ir.actions.act_window">
        <field name="name">Booking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hms.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>