<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="hms_hotel_view_kanban" model="ir.ui.view">
        <field name="name">hms_hotel_view_kanban</field>
        <field name="model">hms.hotel</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="display_name"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image_128" class="w-100 h-auto m-0" widget="image"
                                   options="{'img_class': 'object-fit-contain w-100 h-100'}"/>
                        </aside>
                        <main class="ps-2">
                            <div class="mb-1">
                                <field name="display_name" class="mb-0 fw-bold fs-5"/>
                            </div>
                            <div class="text-truncate">
                                <field name="currency_id"/>
                            </div>
                        </main>
                        <footer>
                            <button name="action_create_booking" string="Create Booking" type="object" class="btn btn-outline-success"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hms_hotel_view_tree" model="ir.ui.view">
        <field name="name">hms_hotel_view_tree</field>
        <field name="model">hms.hotel</field>
        <field name="arch" type="xml">
            <list string="hms_hotel_tree">
                <field name="image_128" widget="image" optional="hide"/>
                <field name="name"/>
                <field name="currency_id"/>
                <field name="room_ids" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hms_hotel_view_form" model="ir.ui.view">
        <field name="name">hms_hotel_view_form</field>
        <field name="model">hms.hotel</field>
        <field name="arch" type="xml">
            <form string="hms_hotel_form">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" class="oe_inline"/></h1>
                    </div>

                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="rooms" string="Rooms">
                            <field name="room_ids" mode="kanban"/>
<!--                                <list>-->
<!--                                    <field name="name"/>-->
<!--                                    <field name="type"/>-->
<!--                                    <field name="amount"/>-->
<!--                                    <field name="currency_id"/>-->
<!--                                </list>-->
<!--                            </field>-->
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hms_hotel_action" model="ir.actions.act_window">
        <field name="name">Hotels</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hms.hotel</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>